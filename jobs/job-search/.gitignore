# Personal data stays on this machine. Fake versions of every one of these live
# in examples/, and the skills in skills/ read the real ones at runtime.
# Patterns start with "/" so they only match at the repo root, not examples/.

# Your profile (name, contact details, work authorization, EEO answers, private
# doc links), your resume, and reference material for drafting answers: brag
# docs, career stories, design docs. These can include employer-confidential
# material.
/reference/

# One folder per application: postings, drafted answers, fill logs, and the
# names and LinkedIn profiles of real people to contact.
/applications/

# Interview study guides written as files (when there's no docs connector).
# They can quote details of your interview loop from your email.
/guides/

# Application tracker (companies, roles, statuses, notes).
/tracker.csv
/tracker.csv.tmp

# Postings job-find found, and its per-search batch files. Not secret, but they
# show what you're searching for. A fake postings.json lives in examples/.
/postings.json
/postings.json.tmp
/postings-raw/

# Old locations of the profile and resume, still ignored in case a copy lands
# here again.
/profile.yaml
/resume/

# Per-machine agent settings, in any folder, and Python caches.
settings.local.json
__pycache__/
