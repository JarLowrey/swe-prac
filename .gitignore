# The history database of the old local server (practice/tools/export_history.py reads it)
data/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Output of build.py (deployed to GitHub Pages), and of practice/tools/build_static.py
site/

